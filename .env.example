# Copy to .env and change both secrets. Never commit .env.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use hex/letters only for POSTGRES_PASSWORD: it goes inside DATABASE_URL, where @ / : # break the URL.
POSTGRES_PASSWORD=change-me
# The backend refuses to start with a secret under 32 characters, so this placeholder must be replaced.
SESSION_SECRET=change-me
# Set to true once the app is served over HTTPS (App Dev B's TLS setup)
COOKIE_SECURE=false

# Used by `npm run dev` / `npm test` in backend/ when running outside Docker
DATABASE_URL=postgres://helpdesk:change-me@localhost:5432/helpdesk
